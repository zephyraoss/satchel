SATCHEL_NODE_ID=node-a
SATCHEL_JOURNAL_DIR=/var/lib/satchel/journals
SATCHEL_S3_ENDPOINT=http://storage-node:9000
SATCHEL_S3_BUCKET=satchel
SATCHEL_S3_ACCESS_KEY=minioadmin
SATCHEL_S3_SECRET_KEY=minioadmin
SATCHEL_S3_PATH_STYLE=true
SATCHEL_S3_HEAD=conditional
SATCHEL_S3_SETTLE=3s
SATCHEL_LEASE_TTL=30s
SATCHEL_SYNC_INTERVAL=5s
SATCHEL_DIRTY_LIMIT=256MiB
SATCHEL_CHECKPOINT_INTERVAL=128
SATCHEL_HISTORY_RETENTION=168h
SATCHEL_GC_GRACE=24h
SATCHEL_METRICS_ADDR=127.0.0.1:9464
SATCHEL_LOG_LEVEL=info
